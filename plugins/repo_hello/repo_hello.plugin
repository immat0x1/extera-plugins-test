from base_plugin import BasePlugin
from ui.bulletin import BulletinHelper

__id__ = "repo_hello"
__name__ = "Repo Hello"
__description__ = "Shows a bulletin when enabled. Installed from a **Git repository**."
__author__ = "@exteraDev"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__category__ = ["tools", "fun"]


class RepoHelloPlugin(BasePlugin):
    def on_plugin_load(self):
        BulletinHelper.show_success("Hello from a Git repository!")
